# ==============================================================================
# SAURAV KUMAR — AI ENGINEER & DATA SCIENTIST PORTFOLIO ENVIRONMENT CONFIGURATION 
# ==============================================================================
# All external services have built-in local fallbacks so the app runs out-of-the-box!

# Database Configuration (Defaults to SQLite `sqlite:///./portfolio.db` when unset)
DATABASE_URL=sqlite:///./portfolio.db
# Example PostgreSQL connection string for production / Docker:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/saurav_portfolio

# Optional LLM Provider Configuration for "Saurav AI" Assistant
# If neither key is set, the assistant automatically uses the verified local RAG engine.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GitHub Integration Configuration
GITHUB_USERNAME=saurav526
GITHUB_TOKEN=

# Optional SMTP Email Configuration for Contact Form
# If unset, messages are persisted to the database and a pre-filled `mailto:` fallback is returned.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_RECEIVER_EMAIL=sauravtiwari2712005@gmail.com

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000
